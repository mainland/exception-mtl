name:           exception-mtl
version:        0.4.0.2
cabal-version:  >= 1.10
license:        BSD3
license-file:   LICENSE
copyright:      (c) 2008-2011 Harvard University
                (c) 2011-2026 Geoffrey Mainland
author:         Geoffrey Mainland <mainland@drexel.edu>
maintainer:     Geoffrey Mainland <mainland@drexel.edu>
stability:      alpha
homepage:       https://github.com/mainland/exception-mtl
bug-reports:    https://github.com/mainland/exception-mtl/issues
category:       Control, Monad, Error Handling, Failure
synopsis:       Exception monad transformer instances for mtl classes.
description:    This package provides exception monad transformer instances for
                the classes defined by mtl.
tested-with:    GHC==8.0.2,
                GHC==8.2.2,
                GHC==8.4.4,
                GHC==8.6.5,
                GHC==8.8.4,
                GHC==8.10.7,
                GHC==9.0.2,
                GHC==9.2.8,
                GHC==9.4.8,
                GHC==9.6.7,
                GHC==9.8.4,
                GHC==9.10.3,
                GHC==9.12.4,
                GHC==9.14.1

build-type:     Simple

library
  default-language: Haskell2010

  exposed-modules:
    Control.Monad.Exception.Instances

  build-depends:
    base                   >= 4.9     && < 5,
    exception-transformers >= 0.4.0.4 && < 0.5,
    mtl                    >= 2.2.1   && < 3,
    transformers           >= 0.5     && < 0.7

  ghc-options:
    -Wall

test-suite unit
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests
  main-is:          Main.hs
  default-language: Haskell2010

  build-depends:
    base                   >= 4.9     && < 5,
    exception-mtl,
    exception-transformers >= 0.4.0.4 && < 0.5,
    mtl                    >= 2.2.1   && < 3,
    tasty                  >= 1.4     && < 1.6,
    tasty-hunit            >= 0.10    && < 0.11,
    transformers           >= 0.5     && < 0.7

  ghc-options:
    -Wall

source-repository head
  type:     git
  location: https://github.com/mainland/exception-mtl.git
